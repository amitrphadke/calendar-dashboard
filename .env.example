# Copy this file to .env for local testing (never commit .env).
# In production these are set as GitHub Actions repo secrets with the same names —
# see .github/workflows/deploy.yml.

# --- Calendar sources (all optional — omit any you don't use) ---

# Google Calendar: Settings > [calendar name] > "Secret address in iCal format"
# One per calendar you want on the dashboard. Add more ICS_URL_* vars and
# wire them up in scripts/fetch-calendars.mjs if you need more than two.
ICS_URL_BUSINESS=https://calendar.google.com/calendar/ical/xxxxx%40malletcrafts.example/private-xxxxxxxxxxxxxxxx/basic.ics
ICS_URL_PERSONAL=https://calendar.google.com/calendar/ical/xxxxx%40gmail.com/private-xxxxxxxxxxxxxxxx/basic.ics

# iCloud: Calendar app > right-click calendar > Share Calendar > Public Calendar
# Copy the webcal:// link and change the scheme to https:// (optional third calendar)
ICS_URL_ICLOUD=https://p01-caldav.icloud.com/published/2/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The 3-month grid (previous/current/next month) always fetches full data
# regardless of this setting. This only controls how much further OUT the
# fetch reaches to catch "!"-important events for the days-remaining rail
# (e.g. a factory delivery date booked months ahead). Default 180.
IMPORTANT_WINDOW_DAYS=180
